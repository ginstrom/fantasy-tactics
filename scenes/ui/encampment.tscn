[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/ui/encampment.gd" id="1_encampment"]

[node name="Encampment" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_encampment")

[node name="Center" type="CenterContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="VBox" type="VBoxContainer" parent="Center"]
layout_mode = 2
theme_override_constants/separation = 16

[node name="Title" type="Label" parent="Center/VBox"]
layout_mode = 2
text = "encampment.title"
horizontal_alignment = 1

[node name="ManagePartyButton" type="Button" parent="Center/VBox"]
layout_mode = 2
text = "encampment.manage_party"

[connection signal="pressed" from="Center/VBox/ManagePartyButton" to="." method="_on_manage_party_pressed"]
