[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/ui/guild_hall.gd" id="1_guild_hall"]

[node name="GuildHall" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_guild_hall")

[node name="Center" type="CenterContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="VBox" type="VBoxContainer" parent="Center"]
layout_mode = 2
theme_override_constants/separation = 16

[node name="Title" type="Label" parent="Center/VBox"]
layout_mode = 2
text = "guild_hall.title"
horizontal_alignment = 1

[node name="LevelLabel" type="Label" parent="Center/VBox"]
layout_mode = 2
horizontal_alignment = 1

[node name="PartySizeLabel" type="Label" parent="Center/VBox"]
layout_mode = 2
horizontal_alignment = 1

[node name="UpgradeButton" type="Button" parent="Center/VBox"]
layout_mode = 2

[node name="MaxLevelLabel" type="Label" parent="Center/VBox"]
layout_mode = 2
visible = false
text = "guild_hall.max_level"
horizontal_alignment = 1

[node name="BackButton" type="Button" parent="Center/VBox"]
layout_mode = 2
text = "ui.back"

[connection signal="pressed" from="Center/VBox/UpgradeButton" to="." method="_on_upgrade_button_pressed"]
[connection signal="pressed" from="Center/VBox/BackButton" to="." method="_on_back_pressed"]
