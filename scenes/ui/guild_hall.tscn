[gd_scene load_steps=3 format=3]

[ext_resource type="Script" path="res://scripts/ui/guild_hall.gd" id="1_guild_hall"]
[ext_resource type="PackedScene" path="res://scenes/ui/camp_nav.tscn" id="2_camp_nav"]

[node name="GuildHall" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_guild_hall")

[node name="Body" type="HBoxContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/separation = 16

[node name="CampNav" parent="Body" instance=ExtResource("2_camp_nav")]
layout_mode = 2
category = 2

[node name="Center" type="CenterContainer" parent="Body"]
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 3

[node name="VBox" type="VBoxContainer" parent="Body/Center"]
layout_mode = 2
theme_override_constants/separation = 16

[node name="Title" type="Label" parent="Body/Center/VBox"]
layout_mode = 2
text = "guild_hall.title"
horizontal_alignment = 1

[node name="LevelLabel" type="Label" parent="Body/Center/VBox"]
layout_mode = 2
horizontal_alignment = 1

[node name="PartySizeLabel" type="Label" parent="Body/Center/VBox"]
layout_mode = 2
horizontal_alignment = 1

[node name="RosterCapLabel" type="Label" parent="Body/Center/VBox"]
layout_mode = 2
horizontal_alignment = 1

[node name="OfferCapLabel" type="Label" parent="Body/Center/VBox"]
layout_mode = 2
horizontal_alignment = 1

[node name="UpgradeButton" type="Button" parent="Body/Center/VBox"]
layout_mode = 2

[node name="MaxLevelLabel" type="Label" parent="Body/Center/VBox"]
layout_mode = 2
visible = false
text = "guild_hall.max_level"
horizontal_alignment = 1

[node name="WatchtowerTitle" type="Label" parent="Body/Center/VBox"]
layout_mode = 2
text = "guild_hall.watchtower.title"
horizontal_alignment = 1

[node name="WatchtowerLevelLabel" type="Label" parent="Body/Center/VBox"]
layout_mode = 2
horizontal_alignment = 1

[node name="WatchtowerUpgradeButton" type="Button" parent="Body/Center/VBox"]
layout_mode = 2

[node name="WatchtowerMaxLevelLabel" type="Label" parent="Body/Center/VBox"]
layout_mode = 2
visible = false
text = "guild_hall.watchtower.max_level"
horizontal_alignment = 1

[node name="QuestsTitle" type="Label" parent="Body/Center/VBox"]
layout_mode = 2
text = "guild_hall.quests.title"
horizontal_alignment = 1

[node name="QuestsEmptyLabel" type="Label" parent="Body/Center/VBox"]
layout_mode = 2
text = "guild_hall.quests.empty"
horizontal_alignment = 1

[node name="QuestList" type="VBoxContainer" parent="Body/Center/VBox"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="BackButton" type="Button" parent="Body/Center/VBox"]
layout_mode = 2
text = "ui.back"

[connection signal="pressed" from="Body/Center/VBox/UpgradeButton" to="." method="_on_upgrade_button_pressed"]
[connection signal="pressed" from="Body/Center/VBox/WatchtowerUpgradeButton" to="." method="_on_watchtower_upgrade_button_pressed"]
[connection signal="pressed" from="Body/Center/VBox/BackButton" to="." method="_on_back_pressed"]
