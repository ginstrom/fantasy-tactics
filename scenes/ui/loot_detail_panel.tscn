[connection signal="pressed" from="Content/ButtonRow/SellButton" to="." method="_on_sell_button_pressed"]
[connection signal="pressed" from="Content/ButtonRow/EquipButton" to="." method="_on_equip_button_pressed"]
[connection signal="pressed" from="Content/CloseButton" to="." method="_on_close_button_pressed"]
