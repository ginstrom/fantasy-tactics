[node name="NameLabel" type="Label" parent="Content"]
layout_mode = 2
horizontal_alignment = 1

[node name="DetailLabel" type="Label" parent="Content"]
layout_mode = 2
horizontal_alignment = 1

[node name="ButtonRow" type="HBoxContainer" parent="Content"]
