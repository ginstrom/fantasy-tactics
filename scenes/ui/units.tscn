[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/ui/units.gd" id="1_units"]

[node name="Units" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_units")

[node name="Center" type="CenterContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="VBox" type="VBoxContainer" parent="Center"]
layout_mode = 2
theme_override_constants/separation = 16

[node name="Title" type="Label" parent="Center/VBox"]
layout_mode = 2
text = "units.title"
horizontal_alignment = 1

[node name="RosterButton" type="Button" parent="Center/VBox"]
layout_mode = 2
disabled = true
text = "ui.tbd"

[node name="PartiesButton" type="Button" parent="Center/VBox"]
layout_mode = 2
text = "units.parties"

[node name="RecruitmentButton" type="Button" parent="Center/VBox"]
layout_mode = 2
disabled = true
text = "ui.tbd"

[node name="BackButton" type="Button" parent="Center/VBox"]
layout_mode = 2
text = "ui.back"

[connection signal="pressed" from="Center/VBox/PartiesButton" to="." method="_on_parties_pressed"]
[connection signal="pressed" from="Center/VBox/BackButton" to="." method="_on_back_pressed"]
