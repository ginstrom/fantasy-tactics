[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/local/starting_settlement.gd" id="1_settlement"]

[node name="StartingSettlement" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_settlement")

[node name="Center" type="CenterContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="VBox" type="VBoxContainer" parent="Center"]
layout_mode = 2
theme_override_constants/separation = 16

[node name="Title" type="Label" parent="Center/VBox"]
layout_mode = 2
text = "settlement.title"
horizontal_alignment = 1

[node name="Description" type="Label" parent="Center/VBox"]
layout_mode = 2
text = "settlement.description"
horizontal_alignment = 1

[node name="EncampmentButton" type="Button" parent="Center/VBox"]
layout_mode = 2
text = "settlement.encampment"

[connection signal="pressed" from="Center/VBox/EncampmentButton" to="." method="_on_encampment_pressed"]
